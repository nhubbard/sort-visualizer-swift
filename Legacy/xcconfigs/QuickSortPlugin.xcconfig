BUILD_LIBRARY_FOR_DISTRIBUTION=NO
CLANG_CXX_LANGUAGE_STANDARD=gnu++20
CODE_SIGN_IDENTITY=
CODE_SIGN_STYLE=Automatic
CURRENT_PROJECT_VERSION=1
DYLIB_COMPATIBILITY_VERSION=1
DYLIB_CURRENT_VERSION=1
DYLIB_INSTALL_NAME_BASE=@rpath
ENABLE_MODULE_VERIFIER=YES
GCC_C_LANGUAGE_STANDARD=gnu17
GENERATE_INFOPLIST_FILE=YES
INFOPLIST_KEY_NSHumanReadableCopyright=
INFOPLIST_KEY_NSPrincipalClass=QuickSortPluginRegistry
INSTALL_PATH=$(LOCAL_LIBRARY_DIR)/Frameworks
IPHONEOS_DEPLOYMENT_TARGET=18.6
LOCALIZATION_PREFERS_STRING_CATALOGS=YES
MARKETING_VERSION=1.0
MODULE_VERIFIER_SUPPORTED_LANGUAGES=objective-c objective-c++
MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS=gnu17 gnu++20
PRODUCT_BUNDLE_IDENTIFIER=com.nhubbard.Sort2.plugins.QuickSortPlugin
PRODUCT_NAME=$(TARGET_NAME:c99extidentifier)
SDKROOT=iphoneos
SKIP_INSTALL=NO
STRING_CATALOG_GENERATE_SYMBOLS=YES
SUPPORTED_PLATFORMS=iphoneos iphonesimulator
SUPPORTS_MACCATALYST=YES
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD=NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD=NO
SWIFT_APPROACHABLE_CONCURRENCY=YES
SWIFT_EMIT_LOC_STRINGS=YES
SWIFT_INSTALL_MODULE=YES
SWIFT_INSTALL_OBJC_HEADER=NO
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY=YES
SWIFT_VERSION=6.0
TARGETED_DEVICE_FAMILY=2
VERSIONING_SYSTEM=apple-generic
VERSION_INFO_PREFIX=

FRAMEWORK_SEARCH_PATHS[config=Debug]=$(inherited) $(SDKROOT)/System/iOSSupport/System/Library/Frameworks
FRAMEWORK_SEARCH_PATHS[config=Release]=$(inherited) $(SDKROOT)/System/iOSSupport/System/Library/Frameworks
LD_RUNPATH_SEARCH_PATHS[config=Debug]=$(inherited) @executable_path/Frameworks @loader_path/Frameworks
LD_RUNPATH_SEARCH_PATHS[config=Release]=$(inherited) @executable_path/Frameworks @loader_path/Frameworks
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]=DEBUG $(inherited)
VALIDATE_PRODUCT[config=Release]=YES