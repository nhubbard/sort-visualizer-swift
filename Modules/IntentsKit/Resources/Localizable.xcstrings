{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "Advances Sort Symphony to the next visualizer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza Sort Symphony al siguiente visualizador."
          }
        }
      }
    },
    "Advances Sort Symphony's default shuffle by one step and returns it — chain with Run Sort to cycle through every shuffle over a long run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza una posición en la mezcla predeterminada de Sort Symphony y la devuelve. Encadénalo con Ejecutar ordenación para recorrer todas las mezclas durante una serie larga."
          }
        }
      }
    },
    "Advances Sort Symphony's visualizer by one step and returns it — chain with Run Sort to cycle through every visualizer over a long run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza una posición en el visualizador de Sort Symphony y lo devuelve. Encadénalo con Ejecutar ordenación para recorrer todos los visualizadores durante una serie larga."
          }
        }
      }
    },
    "Advances the array size of whichever sort is currently open in Sort Symphony.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza al siguiente tamaño del arreglo de la ordenación abierta en Sort Symphony."
