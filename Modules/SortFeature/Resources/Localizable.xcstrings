{
  "sourceLanguage": "en",
  "strings": {
    " Their average separation across selectable sizes is %@%% of the normalized work scale; this is an approximation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Su separación media entre los tamaños seleccionables equivale al %@%% de la escala de trabajo normalizado; es una aproximación."
          }
        }
      }
    },
    "%@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        }
      }
    },
    "%@ implementation, %lld lines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ implementation, %2$lld lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Implementación en %@, %lld líneas."
          }
        }
      }
    },
    "%@ running": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en ejecución"
          }
        }
      }
    },
    "%@, %lld items, %@. Operation %lld of %lld. %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %lld elementos, %@. Operación %lld de %lld. %@"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        },
        "es": {
