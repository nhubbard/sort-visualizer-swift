        }
      }
    },
    "The pivot is below this item, so the right scan advances through larger values.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pivote es menor que este elemento, así que el recorrido derecho avanza por los valores mayores."
          }
        }
