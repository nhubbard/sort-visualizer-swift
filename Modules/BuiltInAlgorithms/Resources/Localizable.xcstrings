        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los extremos opuestos permanecen en su sitio."
          }
        }
      }
    },
    "The other child is at least as large, so follow it instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro hijo no es menor, así que seguirlo en su lugar."
