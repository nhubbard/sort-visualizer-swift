    },
    "3-Smooth Comb Sort (Recursive)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenación de peine 3-smooth (recursiva)"
          }
        }
      }
    },
    "A larger value exists in this window, so the back is not its maximum.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un valor mayor en esta ventana, así que el último no es el máximo."
          }
        }
      }
    },
    "A smaller value exists in this window, so the front is not its minimum.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un valor menor en esta ventana, así que el primero no es el mínimo."
          }
        }
      }
    },
    "A smaller value was found for the current selection position, so exchange it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró un valor menor para la posición de selección actual; intercambiarlos."
          }
        }
      }
    },
    "A value left of the pivot is larger, so this candidate partition fails.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor a la izquierda del pivote es mayor, así que esta partición candidata falla."
          }
        }
      }
    },
    "A value right of the pivot is smaller, so this candidate partition fails.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor a la derecha del pivote es menor, así que esta partición candidata falla."
          }
        }
      }
    },
    "Adaptive Grail Sort": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenación grailsort adaptativa"
          }
        }
      }
    },
    "Adaptive Grail exchanges these positions to rotate a run or its block buffer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive Grail intercambia estas posiciones para rotar una secuencia o su búfer de bloques."
          }
        }
      }
    },
    "Adaptive Grail places the selected value while forming or merging its runs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive Grail coloca el valor seleccionado mientras forma o mezcla sus secuencias."
          }
        }
      }
    },
    "After the exchange, this value belongs below the low pivot.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después del intercambio, este valor pertenece debajo del pivote inferior."
          }
        }
      }
    },
    "After the exchange, this value is below the low pivot and moves left.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después del intercambio, este valor está debajo del pivote inferior y se mueve a la izquierda."
          }
        }
      }
    },
    "After the exchange, this value remains in the middle partition.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después del intercambio, este valor permanece en la partición central."
          }
        }
      }
    },
    "After the exchange, this value stays between the pivots.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después del intercambio, este valor queda entre los pivotes."
          }
        }
      }
    },
