        }
      }
    },
    "The parent pile top is no larger, so heap order holds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cima del montículo padre no es mayor, así que se mantiene el orden del montículo."
          }
        }
      }
    },
    "The parity merge takes the next ordered value from this run into its buffer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mezcla por paridad toma el siguiente valor ordenado de esta secuencia y lo lleva al búfer."
          }
        }
      }
    },
    "The parity merge writes the next ordered buffered value into the main run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mezcla por paridad escribe el siguiente valor ordenado del búfer en la secuencia principal."
          }
        }
      }
    },
    "The pending block key is at least this key, so its search moves right.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave del bloque pendiente no es menor que esta clave, así que su búsqueda avanza a la derecha."
          }
        }
      }
    },
    "The pending block key is smaller, so its insertion search moves left.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave del bloque pendiente es menor, así que su búsqueda de inserción avanza a la izquierda."
          }
        }
      }
    },
    "The pivot candidates are ordered, so median setup keeps this pair.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los candidatos a pivote están ordenados, así que conservar este par al preparar la mediana."
          }
        }
      }
    },
    "The pivot is below this item, so the left scan stops at a larger value.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pivote es menor que este elemento, así que el recorrido izquierdo se detiene en un valor mayor."
